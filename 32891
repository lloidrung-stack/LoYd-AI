*{
    margin:0;
    padding:0;
    box-sizing:border-box;
}

body{
    display:flex;
    height:100vh;
    font-family:Arial,sans-serif;
    background:#202123;
    color:white;
}

.sidebar{
    width:250px;
    background:#171717;
    padding:20px;
    display:flex;
    flex-direction:column;
}

.logo{
    font-size:24px;
    font-weight:bold;
    margin-bottom:20px;
}

.novo-chat{
    padding:12px;
    border:none;
    border-radius:10px;
    background:#10A37F;
    color:white;
    cursor:pointer;
    margin-bottom:20px;
}

.menu{
    display:flex;
    flex-direction:column;
    gap:10px;
}

.item{
    padding:12px;
    border-radius:8px;
    cursor:pointer;
}

.item:hover{
    background:#2b2b2b;
}

.principal{
    flex:1;
    display:flex;
    flex-direction:column;
}

.topo{
    height:70px;
    display:flex;
    justify-content:space-between;
    align-items:center;
    padding:20px;
    border-bottom:1px solid #333;
}

.perfil{
    background:#10A37F;
    padding:10px 15px;
    border-radius:20px;
}

.mensagens{
    flex:1;
    overflow-y:auto;
    padding:20px;
}

.ia{
    background:#2f2f2f;
    padding:15px;
    border-radius:10px;
    max-width:700px;
    margin-bottom:15px;
}

.usuario{
    background:#10A37F;
    padding:15px;
    border-radius:10px;
    max-width:700px;
    margin-left:auto;
    margin-bottom:15px;
}

.entrada{
    display:flex;
    padding:20px;
    gap:10px;
    border-top:1px solid #333;
}

input{
    flex:1;
    padding:15px;
    border:none;
    border-radius:10px;
    outline:none;
    font-size:16px;
}

button{
    padding:15px 25px;
    border:none;
    border-radius:10px;
    background:#10A37F;
    color:white;
    cursor:pointer;
}

button:hover{
    opacity:0.9;
}
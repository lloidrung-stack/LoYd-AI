* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}

body {
    height: 100vh;
    font-family: Arial, sans-serif;
    background: #0d1117;
    color: white;
}

.app {
    height: 100vh;
    display: flex;
    flex-direction: column;
}

/* TOPO */

.topo {
    height: 70px;
    display: flex;
    align-items: center;
    gap: 15px;
    padding: 10px 20px;
    background: #161b22;
    border-bottom: 1px solid #30363d;
}

.marca {
    display: flex;
    align-items: center;
    gap: 10px;
    flex: 1;
    font-size: 22px;
    font-weight: bold;
}

.marca img {
    width: 45px;
    height: 45px;
    object-fit: contain;
    border-radius: 10px;
}

.menu-btn {
    display: none;
    border: none;
    background: transparent;
    color: white;
    font-size: 26px;
    cursor: pointer;
}

.novo-chat {
    border: none;
    background: #008cff;
    color: white;
    padding: 12px 18px;
    border-radius: 12px;
    cursor: pointer;
    font-size: 15px;
}

/* MENU LATERAL */

.menu-lateral {
    position: fixed;
    top: 0;
    left: -290px;
    width: 290px;
    height: 100vh;
    background: #161b22;
    padding: 25px 20px;
    z-index: 1000;
    transition: left 0.3s ease;
    overflow-y: auto;
    box-shadow: 5px 0 20px rgba(0, 0, 0, 0.4);
}

.menu-lateral.aberto {
    left: 0;
}

.menu-lateral h2 {
    color: #008cff;
    margin: 45px 0 25px;
}

.fechar-menu {
    position: absolute;
    top: 15px;
    right: 15px;
    border: none;
    background: transparent;
    color: white;
    font-size: 24px;
    cursor: pointer;
}

.menu-item {
    padding: 14px 10px;
    margin-bottom: 5px;
    border-radius: 10px;
    cursor: pointer;
}

.menu-item:hover {
    background: #21262d;
}

/* HISTÓRICO */

.historico-titulo {
    color: #8b949e;
    font-size: 13px;
    font-weight: bold;
    margin: 22px 10px 8px;
}

.lista-historico {
    margin-bottom: 15px;
}

.lista-historico p {
    color: #777;
    font-size: 13px;
    padding: 8px 10px;
}

.item-historico {
    padding: 10px;
    margin-bottom: 5px;
    border-radius: 8px;
    color: #ddd;
    font-size: 14px;
    cursor: pointer;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
}

.item-historico:hover {
    background: #21262d;
}

/* CHAT */

.chat {
    flex: 1;
    display: flex;
    flex-direction: column;
    min-height: 0;
}

.mensagens {
    flex: 1;
    overflow-y: auto;
    padding: 20px;
}

.mensagem {
    max-width: 700px;
    padding: 15px;
    margin-bottom: 15px;
    border-radius: 15px;
    line-height: 1.5;
    animation: aparecer 0.25s ease;
}

.mensagem p {
    margin-top: 8px;
}

.ia {
    background: #21262d;
    border: 1px solid #30363d;
}

.usuario {
    background: #008cff;
    margin-left: auto;
    margin-right: 0;
    max-width: 70%;
    width: fit-content;
    border-radius: 18px 18px 4px 18px;
}

@keyframes aparecer {
    from {
        opacity: 0;
        transform: translateY(8px);
    }

    to {
        opacity: 1;
        transform: translateY(0);
    }
}

/* ENTRADA */

.entrada {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 15px 20px;
    background: #161b22;
    border-top: 1px solid #30363d;
}

#texto {
    flex: 1;
    min-width: 0;
    height: 52px;
    padding: 14px;
    border: 1px solid #30363d;
    border-radius: 12px;
    outline: none;
    background: #0d1117;
    color: white;
    font-size: 16px;
}

#texto:focus {
    border-color: #008cff;
}

/* BOTÕES */

.entrada button {
    flex-shrink: 0;
    height: 52px;
    border: none;
    border-radius: 12px;
    background: #008cff;
    color: white;
    font-size: 16px;
    cursor: pointer;
}

.entrada button:hover {
    background: #006fc9;
}

.entrada .botao-microfone {
    width: 52px;
    padding: 0;
    font-size: 20px;
}

/* CELULAR */

@media (max-width: 600px) {

    .topo {
        height: 65px;
        padding: 8px 10px;
        gap: 8px;
    }

    .menu-btn {
        display: block;
    }

    .marca {
        font-size: 18px;
    }

    .marca img {
        width: 40px;
        height: 40px;
    }

    .novo-chat {
        padding: 9px 11px;
        font-size: 13px;
    }

    .mensagens {
        padding: 12px;
    }

    .mensagem {
        max-width: 90%;
    }

    .usuario {
        max-width: 75%;
    }

    .entrada {
        padding: 10px;
        gap: 7px;
    }

    #texto {
        height: 50px;
        font-size: 15px;
    }

    .entrada button:last-child {
        width: 90px;
        height: 50px;
        font-size: 14px;
    }

    .entrada .botao-microfone {
        width: 50px;
        height: 50px;
    }
}
function enviar() {

    const input = document.getElementById("texto");
    const mensagens = document.getElementById("mensagens");

    const texto = input.value.trim();

    if (texto === "") {
        return;
    }

    // Mensagem do utilizador
    const usuario = document.createElement("div");

    usuario.className = "mensagem usuario";

    usuario.innerHTML = `
        <strong>Você</strong>
        <p>${escaparHTML(texto)}</p>
    `;

    mensagens.appendChild(usuario);

    input.value = "";

    mensagens.scrollTop = mensagens.scrollHeight;


    // Indicador de resposta
    const digitando = document.createElement("div");

    digitando.className = "mensagem ia";
    digitando.id = "digitando";

    digitando.innerHTML = `
        <strong>LoYd AI 🤖</strong>
        <p>Estou a pensar... ⏳</p>
    `;

    mensagens.appendChild(digitando);

    mensagens.scrollTop = mensagens.scrollHeight;


    // Resposta inicial
    setTimeout(function () {

        digitando.remove();

        responder(texto);

    }, 900);
}


/* Respostas básicas */

function responder(texto) {

    const mensagens = document.getElementById("mensagens");

    const pergunta = texto.toLowerCase();

    let resposta;


    if (
        pergunta.includes("olá") ||
        pergunta.includes("ola") ||
        pergunta.includes("oi")
    ) {

        resposta = "Olá! 👋 Sou o LoYd AI. Como estás?";

    }

    else if (pergunta.includes("quem é você") ||
             pergunta.includes("quem é voce")) {

        resposta = "Sou o LoYd AI 🤖, o teu assistente virtual em desenvolvimento.";

    }

    else if (pergunta.includes("nome")) {

        resposta = "O meu nome é LoYd AI. 😎";

    }

    else if (pergunta.includes("ajuda")) {

        resposta = "Claro! 🚀 Posso conversar contigo e, futuramente, teremos várias outras funções.";

    }

    else if (
        pergunta.includes("obrigado") ||
        pergunta.includes("obrigada")
    ) {

        resposta = "De nada! 😄";

    }

    else {

        resposta =
        "Recebi a tua mensagem! 🤖 Ainda estou em desenvolvimento, mas em breve poderei responder de forma muito mais inteligente. 🚀";

    }


    const ia = document.createElement("div");

    ia.className = "mensagem ia";

    ia.innerHTML = `
        <strong>LoYd AI 🤖</strong>
        <p>${resposta}</p>
    `;

    mensagens.appendChild(ia);

    mensagens.scrollTop = mensagens.scrollHeight;
}


/* Novo Chat */

function novoChat() {

    const mensagens = document.getElementById("mensagens");

    mensagens.innerHTML = `
        <div class="mensagem ia">
            <strong>LoYd AI 🤖</strong>
            <p>Novo chat iniciado! 👋</p>
            <p>Como posso ajudar?</p>
        </div>
    `;

}


/* Enter para enviar */

document.getElementById("texto").addEventListener(
    "keydown",
    function(event) {

        if (event.key === "Enter") {
            enviar();
        }

    }
);


/* Segurança */

function escaparHTML(texto) {

    const div = document.createElement("div");

    div.textContent = texto;

    return div.innerHTML;
}